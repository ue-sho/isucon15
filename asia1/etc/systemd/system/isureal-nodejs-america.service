[Unit]
Description=ISUReal America API near shared PostgreSQL
After=network-online.target
Wants=network-online.target
PartOf=isureal-nodejs.service

[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon/webapp/nodejs
EnvironmentFile=/home/isucon/env.sh
ExecStart=/usr/bin/env ISUREAL_REGION=america ISUREAL_PORT=8082 ISUREAL_WORKERS=1 ISUREAL_DB_POOL_SIZE=2 /home/isucon/local/node/bin/node src/main.ts
Restart=on-failure
RestartSec=5
